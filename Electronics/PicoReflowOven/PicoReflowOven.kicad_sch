	(text "Here I'm using a local 12V DC boost module to provide the \nvoltage required by the enclosure Fan.\n\nThis is only required if you don't have 5V DC Fans at your disposal\n(I only had 12V ones with a boost module, so I'll use that)"
		(exclude_from_sim no)
		(at 217.424 136.398 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5c818d73-dd01-4f7f-882f-21240ac49cc7")
	)
	(text "Used to publish data on a Bluetooth node\nNote: if you're using a Pico W, this connector\nwon't be required."
		(exclude_from_sim no)
		(at 107.696 122.682 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5d478836-a550-4243-8e34-3bc12ca2c419")
	)
	(text "NTC Thermistor is used to measure the triac's tab temperature.\nFan can be controlled when the triac's temperature goes above \na certain threshold (e.g. 35°C and up to 70°C where the \nfan PWM will reach 100% duty cycle).\n\nThis can also be used as a safety thermal cuttof when the triac\nexceeds a given temperature (e.g. 90°C). "
		(exclude_from_sim no)
		(at 113.03 161.29 0)
		(effects
			(font
				(size 0.762 0.762)
			)
		)
		(uuid "615fcf55-a314-460a-805b-355bda42d20d")
	)
	(text "Controls the cooling fan in the 3D printed enclosure"
		(exclude_from_sim no)
		(at 244.094 74.676 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6a33fb05-a2c1-49b6-9651-a8b4679cbe87")
	)
	(text "Pico Reflow Oven main schematic.\nThis board provides all the connectors required to work with the front panel controls, \ndisplay screen (either I2C or SPI TFT).\nIt is also driving the high voltage switching board and various safety components."
		(exclude_from_sim no)
		(at 178.816 171.196 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "75d5a9bd-d9c7-436d-8ead-4fffe0ca7519")
	)
	(text "VBusUsbPC is the USB bus supply \nvoltage coming from a PC connection.\nThis is a supposed to be a temporary\npower rail and the internal power 5V \nsupply should remain the only power \nthat's always ON."
		(exclude_from_sim no)
		(at 108.458 24.892 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left)
		)
		(uuid "7b223178-7aba-4e3e-a2b0-374e3e948ae8")
	)
