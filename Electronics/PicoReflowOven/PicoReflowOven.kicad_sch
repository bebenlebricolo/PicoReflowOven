		(uuid "a676e89b-b6fd-4b9a-bf3a-88cb44a5babd")
	)
	(text "Note: not the final shape, this connector would \nbe fairly limited and won't allow tactile connections \n(additional pins required) nor SD cards (same)\n=> Only used for display"
		(exclude_from_sim no)
		(at 137.922 168.148 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "b02baa31-6d8a-4003-85dd-5a9e2988f466")
	)
	(text "We can either reuse the NanoFridgeThermostatV2 current monitoring chain (the picture here) or\nreimplement the same architecture using a rail-to-rail 3.3V operational amplifier cascade.\n\nNote that output should be kept below 3.3V."
		(exclude_from_sim no)
		(at 46.736 147.574 0)
		(effects
			(font
				(size 0.762 0.762)
			)
		)
		(uuid "dd887bac-b3c7-4a97-8286-e4bc6854da1a")
	)
	(text "Current sensing readings.\n\nCan be used to compute real power \n(heating element behave as purely resistive elements) \nwith a cos phi of 1 and detect triac's fault and thermal locking."
		(exclude_from_sim no)
		(at 16.51 116.078 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "e30b2902-6872-4809-b13f-5c119544492a")
	)
	(text "Triac driving section (triggers the High voltage section)"
		(exclude_from_sim no)
		(at 243.332 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e3f12dee-11a5-4424-9fd0-999f6f4eb441")
	)
	(text "5V from charger bloc\n(through the power switch)"
		(exclude_from_sim no)
		(at 76.454 16.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
